<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
    .header { background: #dc2626; color: #fff; padding: 24px; text-align: center; }
    .header h1 { margin: 0; font-size: 24px; }
    .body { padding: 24px; color: #333; }
    .detail { background: #f9fafb; border-radius: 6px; padding: 16px; margin: 16px 0; }
    .detail p { margin: 4px 0; }
    .label { font-weight: 600; color: #555; }
    .footer { padding: 16px 24px; text-align: center; color: #999; font-size: 12px; border-top: 1px solid #eee; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Booking Cancelled</h1>
    </div>
    <div class="body">
      <p>Hi <strong>{{guestName}}</strong>,</p>
      <p>Your booking at <strong>{{branchName}}</strong> has been cancelled.</p>

      <div class="detail">
        <p><span class="label">Check-in was:</span> {{checkInDate}}</p>
        <p><span class="label">Check-out was:</span> {{checkOutDate}}</p>
        {{#if reason}}
        <p><span class="label">Reason:</span> {{reason}}</p>
        {{/if}}
      </div>

      <p>If you believe this was in error or need assistance, please contact our support team.</p>
    </div>
    <div class="footer">
      <p>© {{year}} Lodgify. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
