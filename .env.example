ENV=dev
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/lodgify?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET="super-secret-jwt-key"
JWT_REFRESH_SECRET="super-secret-refresh-key"

PAYSTACK_SECRET_KEY="sk_test_..."
LOCATIONIQ_API_KEY="pk.your_locationiq_api_key"
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Or alternatively: CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# CORS — comma-separated origins (defaults to localhost:5173,localhost:3000)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# SMTP (Email)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="noreply@lodgify.com"
