generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// CORE: Auth & Users (F-A01 to F-A08)
// ---------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  firstName String
  lastName  String
  role      Role     @default(TRAVELER)
  phone     String?
  avatarUrl String?
  isActive  Boolean  @default(true)
  googleId  String?  @unique
  refreshToken String?
  resetToken   String?
  resetTokenExpires DateTime?
  parentId  String?
  parent    User?    @relation("SubAccounts", fields: [parentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // F-F12: Dietary Preferences
  dietaryPreferences String[]
  allergyNotes       String?

  // Relations
  subAccounts     User[]   @relation("SubAccounts")
  hotel           Hotel?
  properties      Property[]
  bookings        Booking[]
  agentProfile    AgentProfile?
  propertyOwnerProfile PropertyOwnerProfile?
  propertyReviews PropertyReview[]
  inquiries       PropertyInquiry[]
  offers          PurchaseOffer[]
  viewings        ViewingAppointment[]
  sentInvitations SubAccountInvitation[] @relation("SentInvitations")
  guestFoodOrders FoodOrder[] @relation("GuestFoodOrders")
  propertyBookings PropertyBooking[] @relation("GuestPropertyBookings")
  sentPropertyMessages PropertyMessage[] @relation("SentPropertyMessages")
  receivedPropertyMessages PropertyMessage[] @relation("ReceivedPropertyMessages")
  agentReviewsGiven    AgentReview[]      @relation("ClientAgentReviews")
  agentInvitationsSent AgentInvitation[]  @relation("OwnerAgentInvitations")
  savedSearches        BuyerSavedSearch[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HOTEL_OWNER
  BRANCH_MANAGER
  FRONT_DESK
  HOUSEKEEPING
  RESTAURANT_STAFF
  FOOD_SERVICE_MANAGER
  TRAVELER
  PROPERTY_OWNER
  AGENT
}

// ---------------------------------------------------------
// CORE: Hotels & Branches (F-H01 to F-H05)
// ---------------------------------------------------------
model Hotel {
  id              String   @id @default(uuid())
  name            String
  description     String?
  ownerId         String   @unique
  owner           User     @relation(fields: [ownerId], references: [id])
  registrationNo  String?
  taxId           String?
  logoUrl         String?
  starRating      Int?     // 1-5 star classification
  contactEmail    String?
  contactPhone    String?
  status          String   @default("PENDING") // PENDING, ACTIVE, REJECTED, SUSPENDED
  verificationDocuments String[] // URLs of uploaded verification documents
  verificationNotes     String?  // Admin notes on verification decision
  verifiedAt      DateTime?
  verifiedBy      String?  // Admin user ID who verified
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  branches        Branch[]
  inventoryCategories InventoryCategory[]
}

model Branch {
  id              String   @id @default(uuid())
  hotelId         String
  hotel           Hotel    @relation(fields: [hotelId], references: [id])
  name            String
  address         String
  city            String
  state           String
  country         String
  latitude        Float?
  longitude       Float?
  contactEmail    String
  contactPhone    String
  photos          String[] // Branch photo URLs
  amenities       String[] // e.g. ["WIFI", "POOL", "GYM", "PARKING", "SPA"]
  policies        Json?    // Flexible JSON: check-in/out times, cancellation, pet policy, etc.
  foodServiceEnabled Boolean @default(false)
  status          String   @default("ACTIVE") // ACTIVE, DEACTIVATED, OFFLINE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  roomTypes       RoomType[]
  bookings        Booking[]
  inventoryItems  InventoryItem[]
  purchaseOrders  PurchaseOrder[]
  menuCategories  MenuCategory[]
  foodOrders      FoodOrder[]
  dailySpecials   DailySpecial[]

  storageLocations StorageLocation[]
  stockCounts      StockCount[]
  transfersFrom    StockTransfer[] @relation("TransferFrom")
  transfersTo      StockTransfer[] @relation("TransferTo")
  inventoryAlertConfig InventoryAlertConfig?
}

// ---------------------------------------------------------
// CORE: Rooms & Room Types (F-R01 to F-R07)
// ---------------------------------------------------------
model RoomType {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  name            String
  description     String?
  basePrice       Float
  maxOccupancy    Int
  beds            Int
  sizeSqft        Int?
  images          String[]
  amenities       String[] // e.g. ["WIFI", "AC", "TV"]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  rooms           Room[]
  pricingRules    PricingRule[]
  inventoryLinks  RoomTypeInventoryLink[]
}

model Room {
  id              String   @id @default(uuid())
  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id])
  roomNumber      String
  floor           String?
  status          RoomStatus @default(AVAILABLE)
  features        String[]
  images          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  bookings        Booking[]
  maintenanceBlocks RoomMaintenance[]
  inventoryTransactions InventoryTransaction[]

  @@unique([roomTypeId, roomNumber])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
  OUT_OF_ORDER
  BLOCKED
}

model RoomMaintenance {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          MaintenanceStatus @default(SCHEDULED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PricingRule {
  id              String   @id @default(uuid())
  roomTypeId      String
  roomType        RoomType @relation(fields: [roomTypeId], references: [id])
  name            String
  type            String   // SEASONAL, WEEKEND, EVENT
  modifierType    String   // PERCENTAGE, FIXED_AMOUNT
  modifierValue   Float
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------
// CORE: Bookings & Payments (F-B01 to F-B10)
// ---------------------------------------------------------
model Booking {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  guestId         String
  guest           User     @relation(fields: [guestId], references: [id])
  roomId          String?
  room            Room?    @relation(fields: [roomId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime
  guestsCount     Int
  roomPrice       Float?
  totalAmount     Float
  status          BookingStatus @default(PENDING)
  specialRequests String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  payments        Payment[]
  foodOrders      FoodOrder[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Payment {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  amount          Float
  currency        String   @default("NGN")
  method          String   // PAYSTACK, CASH, POS
  status          PaymentStatus @default(PENDING)
  reference       String   @unique
  gatewayResponse Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ---------------------------------------------------------
// INVENTORY & PROCUREMENT (F-I01 to F-I12)
// ---------------------------------------------------------
model InventoryCategory {
  id              String   @id @default(uuid())
  hotelId         String?
  hotel           Hotel?   @relation(fields: [hotelId], references: [id])
  name            String
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           InventoryItem[]
}

model InventoryItem {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  categoryId      String
  category        InventoryCategory @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  sku             String?
  barcode         String?
  defaultSupplierId String?
  defaultSupplier Supplier? @relation(fields: [defaultSupplierId], references: [id])
  photos          String[]
  unit            String   // kg, pcs, liters
  quantity        Float    @default(0) // total quantity across all locations
  minThreshold    Float
  reorderQuantity Float?
  costPerUnit     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  balances        StockBalance[]
  transactions    InventoryTransaction[]
  poItems         PurchaseOrderItem[]
  recipeItems     MenuItemRecipe[]
  transferItems   StockTransferItem[]
  countItems      StockCountItem[]
  roomTypeLinks   RoomTypeInventoryLink[]
}

model InventoryTransaction {
  id              String   @id @default(uuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  type            TransactionType
  quantity        Float
  remarks         String?
  userId          String   // staff who made the transaction

  locationId      String?
  location        StorageLocation? @relation(fields: [locationId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  batchNumber     String?
  expiryDate      DateTime?
  roomId          String?
  room            Room? @relation(fields: [roomId], references: [id])
  foodOrderId     String?
  foodOrder       FoodOrder? @relation(fields: [foodOrderId], references: [id])
  maintenanceId   String?
  maintenance     RoomMaintenance? @relation(fields: [maintenanceId], references: [id])

  createdAt       DateTime @default(now())
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

model Supplier {
  id              String   @id @default(uuid())
  name            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  suppliedItems   String[] // item categories/names this supplier provides
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  purchaseOrders  PurchaseOrder[]
  inventoryItems  InventoryItem[]
  ratings         SupplierRating[]
}

model PurchaseOrder {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  status          POStatus @default(DRAFT)
  totalAmount     Float    @default(0)
  expectedDate    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  items           PurchaseOrderItem[]
  inventoryTransactions InventoryTransaction[]
}

enum POStatus {
  DRAFT
  ISSUED
  PARTIAL
  FULFILLED
  CANCELLED
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  poId            String
  purchaseOrder   PurchaseOrder @relation(fields: [poId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  quantity        Float
  unitPrice       Float
  total           Float
}

model StorageLocation {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  type      String   // MAIN_STORAGE, FLOOR_PANTRY, KITCHEN
  createdAt DateTime @default(now())

  balances  StockBalance[]
  transactions InventoryTransaction[]
}

model StockBalance {
  id              String   @id @default(uuid())
  locationId      String
  location        StorageLocation @relation(fields: [locationId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  quantity        Float    @default(0)
  updatedAt       DateTime @updatedAt
  
  @@unique([locationId, itemId])
}

model InventoryAlertConfig {
  id              String   @id @default(uuid())
  branchId        String   @unique
  branch          Branch   @relation(fields: [branchId], references: [id])
  emailRecipients String[]
  notifyInApp     Boolean  @default(true)
}

model StockTransfer {
  id              String   @id @default(uuid())
  fromBranchId    String
  fromBranch      Branch   @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId      String
  toBranch        Branch   @relation("TransferTo", fields: [toBranchId], references: [id])
  status          String   @default("PENDING") // PENDING, APPROVED, IN_TRANSIT, RECEIVED, REJECTED
  requestedBy     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           StockTransferItem[]
}

model StockTransferItem {
  id              String   @id @default(uuid())
  transferId      String
  transfer        StockTransfer @relation(fields: [transferId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  quantity        Float
}

model SupplierRating {
  id              String   @id @default(uuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  rating          Int      // 1-5 stars
  deliveryRating  Int?     // 1-5 reliability rating
  qualityRating   Int?     // 1-5 quality rating
  comment         String?
  ratedBy         String   // userId
  createdAt       DateTime @default(now())
}

model StockCount {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  status          String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  initiatedBy     String   // userId
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           StockCountItem[]
}

model StockCountItem {
  id              String     @id @default(uuid())
  stockCountId    String
  stockCount      StockCount @relation(fields: [stockCountId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  systemQuantity  Float      // snapshot of system qty at count initiation
  actualQuantity  Float?     // physically counted qty
  variance        Float?     // actual - system
  status          String     @default("PENDING") // PENDING, COUNTED, ADJUSTED, FLAGGED
  adjustedAt      DateTime?
  notes           String?
}

model RoomTypeInventoryLink {
  id              String    @id @default(uuid())
  roomTypeId      String
  roomType        RoomType  @relation(fields: [roomTypeId], references: [id])
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  quantityPerClean Float    // e.g., 2 shampoo bottles per cleaning
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([roomTypeId, itemId])
}

// ---------------------------------------------------------
// F&B / RESTAURANT (F-F01 to F-F12)
// ---------------------------------------------------------
model MenuCategory {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  name            String
  description     String?
  availableFrom   String?  // e.g. "06:00"
  availableTo     String?  // e.g. "11:00"
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           MenuItem[]
}

model MenuItem {
  id              String   @id @default(uuid())
  categoryId      String
  category        MenuCategory @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  price           Float
  imageUrl        String?
  photos          String[]
  dietaryTags     String[]  // ["vegetarian", "vegan", "gluten-free", "halal"]
  availability    String   @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, SEASONAL
  isAvailable     Boolean  @default(true)
  preparationTime Int?     // in minutes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  recipe          MenuItemRecipe[]
  orderItems      FoodOrderItem[]
  dailySpecials   DailySpecial[]
}

model MenuItemRecipe {
  id              String   @id @default(uuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityNeeded  Float
}

model DailySpecial {
  id               String   @id @default(uuid())
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])
  menuItemId       String
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id])
  promotionalPrice Float
  description      String?
  startsAt         DateTime
  expiresAt        DateTime
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model FoodOrder {
  id                    String   @id @default(uuid())
  branchId              String
  branch                Branch   @relation(fields: [branchId], references: [id])
  bookingId             String?
  booking               Booking? @relation(fields: [bookingId], references: [id])
  guestId               String?
  guest                 User?    @relation("GuestFoodOrders", fields: [guestId], references: [id])
  tableNumber           String?
  roomNumber            String?
  deliveryType          String   @default("ASAP") // ASAP, SCHEDULED
  scheduledTime         DateTime?
  paymentMethod         String?  // PAYSTACK, BILL_TO_ROOM
  paymentReference      String?
  estimatedDeliveryTime Int?     // minutes
  status                FoodOrderStatus @default(PENDING)
  totalAmount           Float
  specialNotes          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  items                 FoodOrderItem[]
  inventoryTransactions InventoryTransaction[]
}

enum FoodOrderStatus {
  PENDING
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model FoodOrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           FoodOrder @relation(fields: [orderId], references: [id])
  menuItemId      String
  menuItem        MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity        Int
  unitPrice       Float
  subtotal        Float
  notes           String?
}

// ---------------------------------------------------------
// PROPERTY MARKETPLACE (F-P01 to F-P12)
// ---------------------------------------------------------
model Property {
  id              String   @id @default(uuid())
  title           String
  description     String
  type            String   // APARTMENT, VILLA, TOWNHOUSE, COMMERCIAL, LAND
  listingType     String   // SHORT_TERM_RENT, LONG_TERM_RENT, SALE
  price           Float    // Base price / sale price
  currency        String   @default("NGN")
  address         String
  city            String
  state           String
  country         String
  latitude        Float?
  longitude       Float?
  bedrooms        Int?
  bathrooms       Int?
  areaSqft        Int?
  status          String   @default("AVAILABLE") // DRAFT, AVAILABLE, PAUSED, RENTED, SOLD, OFFLINE
  features        String[]

  // F-P01 & F-P05: Media, Details & Rules
  videoTourUrl    String?
  floorPlanUrl    String?
  amenities       String[] // e.g. ["WIFI", "POOL", "KITCHEN", "AIR_CONDITIONING", "PARKING", "ELEVATOR"]
  houseRules      String[] // e.g. ["NO_SMOKING", "NO_PARTIES", "QUIET_HOURS_10PM"]
  cancellationPolicy String @default("FLEXIBLE") // FLEXIBLE, MODERATE, STRICT
  petFriendly     Boolean  @default(false)
  furnished       Boolean  @default(false)
  maxGuests       Int      @default(1)

  // F-P02: Pricing Configuration
  nightlyRate     Float?
  monthlyRate     Float?
  securityDeposit Float?   @default(0)
  cleaningFee     Float?   @default(0)
  additionalGuestFee Float? @default(0)
  baseGuests      Int      @default(1)
  minStayNights   Int      @default(1)
  instantBookable Boolean  @default(false)

  // F-PS01: Sale Listing Configuration
  askingPrice     Float?
  isPriceNegotiable Boolean  @default(false)
  yearBuilt       Int?
  titleType       String?  // C_OF_O, GOVERNORS_CONSENT, GAZETTE, DEED_OF_ASSIGNMENT, EXCISION, SURVEY_PLAN
  neighborhoodDescription String?
  nearbyAmenities String[] // e.g. ["SCHOOLS", "SHOPPING_MALL", "HOSPITAL", "HIGHWAY_ACCESS", "AIRPORT"]
  salesPipelineStatus String @default("LISTED") // LISTED, OFFER_RECEIVED, NEGOTIATING, OFFER_ACCEPTED, DUE_DILIGENCE, CLOSING, SOLD

  // F-P09: Verification Badges
  isOwnerVerified Boolean  @default(false)
  isOwnershipVerified Boolean @default(false)
  isPhotoVerified Boolean  @default(false)
  verificationStatus String @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  verificationNotes String?

  // F-P11: Performance Analytics
  viewsCount      Int      @default(0)
  inquiriesCount  Int      @default(0)
  bookingsCount   Int      @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)

  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  images          PropertyImage[]
  inquiries       PropertyInquiry[]
  reviews         PropertyReview[]
  authorizations  AgentAuthorization[]
  offers          PurchaseOffer[]
  viewings        ViewingAppointment[]
  blockedDates    PropertyBlockedDate[]
  pricingRules    PropertyPricingRule[]
  bookings        PropertyBooking[]
  messages        PropertyMessage[]
  leads           Lead[]
  commissions     CommissionRecord[]
  agentInvitations AgentInvitation[]
  saleDocuments   PropertySaleDocument[]
  milestones      SaleTransactionMilestone[]
  savedSearches   BuyerSavedSearch[]
}

model PropertyImage {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  url             String
  isPrimary       Boolean  @default(false)
  caption         String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
}

model PropertyInquiry {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  name            String
  email           String
  phone           String
  message         String
  status          String   @default("NEW") // NEW, READ, RESPONDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// F-P03: Availability Calendar & Blocks
model PropertyBlockedDate {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  startDate       DateTime
  endDate         DateTime
  reason          String?
  source          String   @default("MANUAL") // MANUAL, BOOKING, ICAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, startDate, endDate])
}

// F-P02: Dynamic Pricing Rules
model PropertyPricingRule {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  name            String
  type            String   // SEASONAL, WEEKEND, CUSTOM
  modifierType    String   // PERCENTAGE, FIXED_AMOUNT, NIGHTLY_RATE
  modifierValue   Float
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, isActive])
}

// F-P06 & F-P07: Rental Bookings & Request Management
model PropertyBooking {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  guestId         String
  guest           User     @relation("GuestPropertyBookings", fields: [guestId], references: [id])
  checkInDate     DateTime
  checkOutDate    DateTime
  nights          Int
  guestsCount     Int
  baseAmount      Float
  cleaningFee     Float    @default(0)
  securityDeposit Float    @default(0)
  extraGuestsFee  Float    @default(0)
  totalAmount     Float
  currency        String   @default("NGN")
  status          String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED, CANCELLED, PAID, CHECKED_IN, COMPLETED
  paymentMethod   String?  // PAYSTACK, TRANSFER, CARD
  paymentReference String?
  rentalAgreementText String?
  specialRequests String?
  declineReason   String?
  expiresAt       DateTime? // 24h timeout default for booking requests
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews         PropertyReview[]
  messages        PropertyMessage[]

  @@index([propertyId, checkInDate, checkOutDate])
  @@index([guestId])
}

// F-P08: Guest-Owner Messaging
model PropertyMessage {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  senderId        String
  sender          User     @relation("SentPropertyMessages", fields: [senderId], references: [id])
  receiverId      String
  receiver        User     @relation("ReceivedPropertyMessages", fields: [receiverId], references: [id])
  bookingId       String?
  booking         PropertyBooking? @relation(fields: [bookingId], references: [id])
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([propertyId, senderId, receiverId])
}

// F-P10: Review & Rating System
model PropertyReview {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  bookingId       String?
  booking         PropertyBooking? @relation(fields: [bookingId], references: [id])
  
  // 6-Category Rating System
  cleanliness     Int      @default(5)
  accuracy        Int      @default(5)
  checkIn         Int      @default(5)
  communication   Int      @default(5)
  location        Int      @default(5)
  value           Int      @default(5)
  overallRating   Float    @default(5.0)
  
  comment         String?
  ownerResponse   String?
  ownerRespondedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
}

// ---------------------------------------------------------
// AGENTS & SALES (F-AG01 to F-AG12)
// ---------------------------------------------------------
model AgentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  accountType     String   @default("INDIVIDUAL") // INDIVIDUAL, COMPANY
  agencyName      String?
  licenseNumber   String?
  bio             String?
  photoUrl        String?
  specializations String[] // e.g. ["LUXURY_VILLAS", "COMMERCIAL", "SHORT_TERM_RENTALS", "RESIDENTIAL"]
  areasServed     String[] // e.g. ["LEKKI", "VICTORIA_ISLAND", "IKOYI", "IKEJA"]
  yearsOfExperience Int?
  website         String?
  socialLinks     Json?
  
  // Verification (F-AG02)
  licenseUrl      String?
  companyRegistrationUrl String?
  idDocumentUrl   String?
  isVerified      Boolean  @default(false)
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  verificationNotes String?

  tier            String   @default("STANDARD") // STANDARD, PREMIUM
  commissionRate  Float    @default(5.0)
  totalSales      Float    @default(0)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  bankAccountDetails Json? // Bank details for automated payouts

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorizations  AgentAuthorization[]
  leads           Lead[]
  commissions     CommissionRecord[]
  reviews         AgentReview[]
  invitations     AgentInvitation[]
  viewings        ViewingAppointment[]
}

model AgentAuthorization {
  id              String   @id @default(uuid())
  agentId         String
  agent           AgentProfile @relation(fields: [agentId], references: [id])
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  status          String   @default("PENDING") // PENDING, APPROVED, DECLINED, REVOKED
  pitchMessage    String?
  proposedRate    Float?
  agreedRate      Float?
  declineReason   String?
  referralCode    String   @unique @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, propertyId])
}

model Lead {
  id              String   @id @default(uuid())
  agentId         String
  agent           AgentProfile @relation(fields: [agentId], references: [id])
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])
  name            String
  email           String?
  phone           String?
  source          String?  // REFERRAL_LINK, DIRECT_INQUIRY, SOCIAL, MANUAL
  status          String   @default("NEW") // NEW, CONTACTED, VIEWING_SCHEDULED, NEGOTIATING, CLOSED_WON, CLOSED_LOST
  estimatedValue  Float?
  notes           String?
  stageHistory    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  viewings        ViewingAppointment[]
}

model CommissionRecord {
  id              String   @id @default(uuid())
  agentId         String
  agent           AgentProfile @relation(fields: [agentId], references: [id])
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])
  bookingId       String?
  transactionType String   // SALE, RENTAL
  totalTransactionValue Float?
  agreedRate      Float    @default(5.0)
  amount          Float
  status          String   @default("PENDING") // PENDING, CONFIRMED, READY_FOR_PAYOUT, PAID
  payoutMethod    String?  // PAYSTACK, BANK_TRANSFER
  payoutReference String?
  payoutReceiptUrl String?
  paidAt          DateTime?
  referenceId     String?  // ID of the sale/rental booking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// F-AG12: Client Reviews for Agents
model AgentReview {
  id              String   @id @default(uuid())
  agentId         String
  agent           AgentProfile @relation(fields: [agentId], references: [id])
  reviewerId      String
  reviewer        User     @relation("ClientAgentReviews", fields: [reviewerId], references: [id])
  professionalism Int      @default(5)
  marketKnowledge Int      @default(5)
  responsiveness  Int      @default(5)
  overallRating   Float    @default(5.0)
  comment         String?
  createdAt       DateTime @default(now())

  @@index([agentId])
}

// F-AG04 & F-AG12: Owner Agent Invitation
model AgentInvitation {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  ownerId         String
  owner           User     @relation("OwnerAgentInvitations", fields: [ownerId], references: [id])
  agentId         String
  agent           AgentProfile @relation(fields: [agentId], references: [id])
  proposedRate    Float?
  message         String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agentId, status])
}

// ---------------------------------------------------------
// OFFERS & PROPERTY SALES (F-PS01 to F-PS10)
// ---------------------------------------------------------
model PurchaseOffer {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  offerAmount     Float
  conditions      String?
  
  // F-PS02: Formal Offer Details
  financingMethod String   @default("CASH") // CASH, MORTGAGE
  proposedClosingDate DateTime?
  contingencies   String[] // ["INSPECTION", "APPRAISAL", "FINANCING", "TITLE_SEARCH"]
  earnestDepositAmount Float @default(0)
  earnestDepositStatus String @default("PENDING") // PENDING, HELD_IN_ESCROW, CREDITED_AT_CLOSING, REFUNDED, FORFEITED
  earnestDepositReference String?
  earnestDepositPaidAt DateTime?
  preApprovalLetterUrl String?

  // F-PS03: Counter-Offer & Negotiation
  counterAmount   Float?
  counterConditions String?
  counteredBy     String?  // BUYER, SELLER
  negotiationHistory Json? // Array of negotiation history rounds

  status          String   @default("SUBMITTED") // SUBMITTED, ACCEPTED, REJECTED, COUNTERED, EXPIRED, WITHDRAWN
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  milestones      SaleTransactionMilestone[]

  @@index([propertyId, status])
}

model ViewingAppointment {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  agentId         String?
  agent           AgentProfile? @relation(fields: [agentId], references: [id])
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  clientName      String
  clientEmail     String
  clientPhone     String
  scheduledDate   DateTime

  // F-PS06: Viewing Types & Host
  viewingType     String   @default("PRIVATE_SHOWING") // OPEN_HOUSE, PRIVATE_SHOWING, VIRTUAL_TOUR
  hostType        String   @default("OWNER") // OWNER, AGENT
  hostId          String?

  status          String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, RESCHEDULED
  notes           String?
  feedback        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, scheduledDate])
}

// F-PS07: Secure Legal Document Management for Property Sales
model PropertySaleDocument {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  title           String
  docType         String   // TITLE_DEED, SURVEY_PLAN, TAX_CLEARANCE, BUILDING_APPROVAL, OTHER
  fileUrl         String
  isConfidential  Boolean  @default(true)
  accessLevel     String   @default("RESTRICTED") // RESTRICTED, PUBLIC, VERIFIED_BUYERS_ONLY
  uploadedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId])
}

// F-PS09: Buyer Saved Searches & Notification Alerts
model BuyerSavedSearch {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id])
  name            String
  criteria        Json     // e.g. { minPrice, maxPrice, bedrooms, propertyType, city, neighborhood }
  emailAlerts     Boolean  @default(true)
  alertFrequency  String   @default("INSTANT") // INSTANT, DAILY, WEEKLY
  lastAlertSentAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

// F-PS10: Sales Transaction Milestones Tracker
model SaleTransactionMilestone {
  id              String   @id @default(uuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  offerId         String
  offer           PurchaseOffer @relation(fields: [offerId], references: [id])
  milestoneType   String   // OFFER_ACCEPTED, INSPECTION_COMPLETE, FINANCING_SECURED, TITLE_VERIFIED, CLOSING_DATE_SET, FUNDS_TRANSFERRED, KEYS_HANDED_OVER
  name            String
  description     String?
  status          String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, WAIVED
  dueDate         DateTime?
  completedAt     DateTime?
  attachmentUrls  String[]
  notes           String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([offerId])
  @@index([propertyId])
}

// ---------------------------------------------------------
// SYSTEM: Audit Logs (F-ADM01)
// ---------------------------------------------------------
enum AuditLogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

enum AuditLogAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_SUSPENDED
  USER_ACTIVATED
  AGENT_VERIFIED
  AGENT_REJECTED
  BOOKING_CREATED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  ROOM_CREATED
  ROOM_UPDATED
  HOTEL_CREATED
  HOTEL_UPDATED
  HOTEL_APPROVED
  HOTEL_REJECTED
  BRANCH_DEACTIVATED
  BRANCH_REACTIVATED
  SYSTEM_STARTUP
  SYSTEM_ERROR
  CONFIG_CHANGED
}

model AuditLog {
  id          String         @id @default(uuid())
  level       AuditLogLevel  @default(INFO)
  action      AuditLogAction
  message     String
  actorId     String?
  actorEmail  String?
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  @@index([level])
  @@index([action])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------
// NEW MODELS: Verification & Invitations
// ---------------------------------------------------------

model PropertyOwnerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  deedUrl         String?
  utilityBillUrl  String?
  idUrl           String?
  status          String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SubAccountInvitation {
  id              String   @id @default(uuid())
  senderId        String
  sender          User     @relation("SentInvitations", fields: [senderId], references: [id])
  email           String
  role            Role
  status          String   @default("PENDING") // PENDING, ACCEPTED, CANCELLED
  token           String   @unique
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
